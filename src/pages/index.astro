---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Probetraining from "../components/Probetraining.astro";
---

<Layout title="KARATEPROFI">

  <Header />

  <main class="overflow-hidden">

    <section class="py-16 sm:py-24 lg:py-32 px-4 sm:px-6 max-w-4xl mx-auto text-center">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 mb-6 leading-[1.15]">
        Karate mit Herz, Haltung und Tradition. <span class="text-sky-600 block sm:inline">Mitten in Wien-Favoriten.</span>
      </h1>

      <p class="text-base sm:text-lg text-slate-600 mb-8 max-w-xl mx-auto leading-relaxed">
        Vom kindgerechten Einstieg bis zum fortgeschrittenen Breitensport. Erleben Sie professionelles Training in entspannter, sicherer Atmosphäre.
      </p>

      <div class="flex flex-col sm:flex-row justify-center gap-3">
        <button type="button" id="open-probetraining-modal" class="bg-sky-600 hover:bg-sky-700 text-white font-semibold px-8 py-4 rounded-xl transition-all shadow-lg shadow-sky-600/20 text-base text-center cursor-pointer">
          Gratis Probetraining anfragen
        </button>
        <a href="/kurse" class="bg-white hover:bg-slate-50 text-slate-700 font-semibold px-8 py-4 rounded-xl transition-all border border-slate-200 text-base text-center">
          Zu den Kursen & Zeiten →
        </a>
      </div>
    </section>

    <section class="py-16 px-4 sm:px-6 bg-white border-t border-slate-100">
      <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-8 text-center md:text-left">
        <div>
          <h3 class="font-bold text-slate-900 text-lg mb-2">Fokus & Konzentration</h3>
          <p class="text-slate-600 text-sm leading-relaxed">Kinder lernen spielerisch, ihre Aufmerksamkeit für den Schulalltag zu bündeln.</p>
        </div>
        <div>
          <h3 class="font-bold text-slate-900 text-lg mb-2">Pädagogisch geleitet</h3>
          <p class="text-slate-600 text-sm leading-relaxed">Geleitet von Dr. Christian Schättle (Hort- & Freizeitpädagoge & staatlicher Trainer).</p>
        </div>
        <div>
          <h3 class="font-bold text-slate-900 text-lg mb-2">Werte statt Rauferei</h3>
          <p class="text-slate-600 text-sm leading-relaxed">Respekt, Fairness und Teamgeist stehen bei jedem Training an erster Stelle.</p>
        </div>
      </div>

      <div class="text-center mt-12">
        <a href="/ueber-uns" class="text-sky-600 hover:text-sky-700 font-semibold text-sm">
          Mehr über unsere Philosophie und Trainer erfahren →
        </a>
      </div>
    </section>

    <Probetraining/>

  </main>
</Layout>