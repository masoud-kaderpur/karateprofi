---
---
<div id="probetraining-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden">

  <div class="relative bg-white border border-sky-100 rounded-3xl p-6 sm:p-10 shadow-2xl max-w-lg w-full max-h-[90vh] overflow-y-auto">

    <button type="button" id="close-modal" class="absolute top-5 right-5 text-slate-400 hover:text-slate-700 w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center font-bold text-sm transition-colors">
      ✕
    </button>

    <div id="step-1" class="probetraining-step">
      <div class="inline-block bg-sky-100 text-sky-800 text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wider mb-4">
        Schritt 1 von 3
      </div>
      <h3 class="text-xl sm:text-2xl font-bold text-slate-900 mb-2">Wie alt ist dein Kind?</h3>
      <p class="text-slate-600 text-sm mb-6">Wähle einfach die passende Altersgruppe aus:</p>

      <div class="grid grid-cols-1 gap-2.5">
        <button type="button" data-age="3 bis 6 Jahre (Kindergarten)" class="age-btn text-left p-3.5 rounded-2xl border border-slate-200 hover:border-sky-500 hover:bg-sky-50/50 transition-all group">
          <div class="font-bold text-slate-900 group-hover:text-sky-700 text-sm">3 bis 6 Jahre</div>
          <div class="text-xs text-slate-500 mt-0.5">Kindergarten</div>
        </button>
        <button type="button" data-age="6 bis 10 Jahre (Volksschule)" class="age-btn text-left p-3.5 rounded-2xl border border-slate-200 hover:border-sky-500 hover:bg-sky-50/50 transition-all group">
          <div class="font-bold text-slate-900 group-hover:text-sky-700 text-sm">6 bis 10 Jahre</div>
          <div class="text-xs text-slate-500 mt-0.5">Volksschule</div>
        </button>
        <button type="button" data-age="10 bis 14 Jahre (Mittelschule)" class="age-btn text-left p-3.5 rounded-2xl border border-slate-200 hover:border-sky-500 hover:bg-sky-50/50 transition-all group">
          <div class="font-bold text-slate-900 group-hover:text-sky-700 text-sm">10 bis 14 Jahre</div>
          <div class="text-xs text-slate-500 mt-0.5">Mittelschule / Jugend</div>
        </button>
        <button type="button" data-age="Ab 14 Jahren / Erwachsene / USI" class="age-btn text-left p-3.5 rounded-2xl border border-slate-200 hover:border-sky-500 hover:bg-sky-50/50 transition-all group">
          <div class="font-bold text-slate-900 group-hover:text-sky-700 text-sm">Ab 14 Jahren & Ältere</div>
          <div class="text-xs text-slate-500 mt-0.5">Jugend, Erwachsene & USI</div>
        </button>
      </div>
    </div>

    <div id="step-2" class="probetraining-step hidden">
      <div class="inline-block bg-sky-100 text-sky-800 text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wider mb-4">
        Schritt 2 von 3
      </div>
      <h3 class="text-xl sm:text-2xl font-bold text-slate-900 mb-2">Welcher Tag passt euch?</h3>
      <p class="text-slate-600 text-sm mb-6">Wählt euren bevorzugten Wochentag:</p>

      <div class="grid grid-cols-1 gap-2.5">
        <button type="button" data-day="Montag" class="day-btn text-left p-3.5 rounded-2xl border border-slate-200 hover:border-sky-500 hover:bg-sky-50/50 transition-all group flex justify-between items-center">
          <div>
            <div class="font-bold text-slate-900 group-hover:text-sky-700 text-sm">Montag</div>
            <div class="text-xs text-slate-500">Regulärer Haupttermin</div>
          </div>
          <span class="text-xs font-semibold text-sky-600">Auswählen →</span>
        </button>
        <button type="button" data-day="Mittwoch" class="day-btn text-left p-3.5 rounded-2xl border border-slate-200 hover:border-sky-500 hover:bg-sky-50/50 transition-all group flex justify-between items-center">
          <div>
            <div class="font-bold text-slate-900 group-hover:text-sky-700 text-sm">Mittwoch</div>
            <div class="text-xs text-slate-500">Regulärer Haupttermin</div>
          </div>
          <span class="text-xs font-semibold text-sky-600">Auswählen →</span>
        </button>
        <button type="button" data-day="Egal / Flexibel (Sommer: Dienstag)" class="day-btn text-left p-3.5 rounded-2xl border border-slate-200 hover:border-sky-500 hover:bg-sky-50/50 transition-all group flex justify-between items-center">
          <div>
            <div class="font-bold text-slate-900 group-hover:text-sky-700 text-sm">Flexibel / Sommer (Dienstag)</div>
            <div class="text-xs text-slate-500">Wir richten uns nach euch</div>
          </div>
          <span class="text-xs font-semibold text-sky-600">Auswählen →</span>
        </button>
      </div>

      <div class="flex justify-between mt-6">
        <button type="button" id="back-to-1" class="text-sm text-slate-500 hover:text-slate-800 font-medium">← Zurück</button>
      </div>
    </div>

    <div id="step-3" class="probetraining-step hidden">
      <div class="inline-block bg-sky-100 text-sky-800 text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wider mb-4">
        Schritt 3 von 3
      </div>
      <h3 class="text-xl sm:text-2xl font-bold text-slate-900 mb-2">Wie erreichen wir euch?</h3>
      <p class="text-slate-600 text-sm mb-6">Wir melden uns in Kürze mit eurem Termin.</p>

    <form id="contact-form" class="space-y-4" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value="391d33c6-f13a-4869-87ef-322d092bb8c1">
      <input type="hidden" id="input-altersgruppe" name="Altersgruppe" value="">
      <input type="hidden" id="input-tag" name="Wunschtag" value="">

      <div>
        <label for="input-name" class="block text-xs font-semibold text-slate-700 mb-1">Name</label>
        <input  type="text" id="input-name" name="Name" required class="w-full p-3.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-sky-500" placeholder="z.B. Maria Huber">
      </div>
      <div>
        <label for="input-email" class="block text-xs font-semibold text-slate-700 mb-1">E-Mail-Adresse</label>
        <input type="email" id="input-email" name="Email" required class="w-full p-3.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-sky-500" placeholder="huber@beispiel.at">
      </div>
      <div>
        <label for="input-phone" class="block text-xs font-semibold text-slate-700 mb-1">Telefonnummer </label>
        <input type="tel" id="input-phone" name="Telefon" required class="w-full p-3.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-sky-500" placeholder="+43 ...">
      </div>

        <div class="flex justify-between items-center mt-6">
          <button type="button" id="back-to-2" class="text-sm text-slate-500 hover:text-slate-800 font-medium">← Zurück</button>
          <button type="submit" id="submit-btn" class="bg-sky-600 hover:bg-sky-700 text-white font-bold px-6 py-3 rounded-xl transition-all shadow-md text-sm">
            Absenden
          </button>
        </div>
      </form>
    </div>

    <div id="step-success" class="hidden text-center py-6">
      <div class="w-14 h-14 bg-sky-100 text-sky-600 rounded-full flex items-center justify-center text-2xl mx-auto mb-3">
        ✨
      </div>
      <h3 class="text-xl font-bold text-slate-900 mb-2">Anfrage erhalten!</h3>
      <p class="text-slate-600 text-sm max-w-sm mx-auto mb-5">
        Dr. Christian Schättle wurde informiert und meldet sich in Kürze wegen des Termins (<span id="summary-day" class="font-semibold text-slate-800"></span>) für <span id="summary-age" class="font-semibold text-slate-800"></span> bei euch.
      </p>
      <div class="bg-sky-50 border border-sky-100 p-3 rounded-2xl text-xs text-slate-700 mb-5">
        💡 <strong>Tipp:</strong> Einfach bequeme Sportkleidung einpacken. Wir trainieren barfuß!
      </div>
      <button type="button" id="close-success-btn" class="bg-slate-900 text-white font-semibold px-6 py-2.5 rounded-xl text-sm hover:bg-slate-800 transition-all">
        Fenster schließen
      </button>
    </div>

  </div>
</div>

<script lang="js">
  document.addEventListener('DOMContentLoaded', () => {
    let selectedAge = '';
    let selectedDay = '';

    const modal = document.getElementById('probetraining-modal');
    const openBtn = document.getElementById('open-probetraining-modal');
    const closeBtn = document.getElementById('close-modal');
    const closeSuccessBtn = document.getElementById('close-success-btn');

    const steps = {
      1: document.getElementById('step-1'),
      2: document.getElementById('step-2'),
      3: document.getElementById('step-3'),
      success: document.getElementById('step-success')
    };

    function showStep(stepNum) {
      Object.values(steps).forEach(el => el?.classList.add('hidden'));
      if (steps[stepNum]) {
        steps[stepNum].classList.remove('hidden');
      }
    }

    openBtn?.addEventListener('click', () => {
      modal.classList.remove('hidden');
      showStep(1);
    });

    function closeModal() {
      modal.classList.add('hidden');
    }

    closeBtn?.addEventListener('click', closeModal);
    closeSuccessBtn?.addEventListener('click', closeModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    document.querySelectorAll('.age-btn').forEach(button => {
      button.addEventListener('click', () => {
        selectedAge = button.getAttribute('data-age');
        document.getElementById('input-altersgruppe').value = selectedAge;
        showStep(2);
      });
    });

    document.querySelectorAll('.day-btn').forEach(button => {
      button.addEventListener('click', () => {
        selectedDay = button.getAttribute('data-day');
        document.getElementById('input-tag').value = selectedDay;
        showStep(3);
      });
    });

    document.getElementById('back-to-1')?.addEventListener('click', () => showStep(1));
    document.getElementById('back-to-2')?.addEventListener('click', () => showStep(2));

    const form = document.getElementById('contact-form');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitBtn = document.getElementById('submit-btn');
      submitBtn.innerText = "Wird gesendet...";
      submitBtn.disabled = true;

      const formData = new FormData(form);

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData
        });
        const data = await response.json();

        if (data.success) {
          steps[3].classList.add('hidden');
          document.getElementById('summary-age').innerText = selectedAge;
          document.getElementById('summary-day').innerText = selectedDay;
          steps.success.classList.remove('hidden');
          submitBtn.innerText = "Absenden 🚀";
          submitBtn.disabled = false;
          form.reset();
        } else {
          alert("Fehler beim Senden. Bitte versuche es direkt per E-Mail an info@karateprofi.at");
          submitBtn.innerText = "Absenden 🚀";
          submitBtn.disabled = false;
        }
      } catch (error) {
        alert("Netzwerkfehler. Bitte versuche es später noch einmal.");
        submitBtn.innerText = "Absenden 🚀";
        submitBtn.disabled = false;
      }
    });
  });
</script>