---
const currentYear = new Date().getFullYear();
---

<footer class="bg-white py-10 px-4 sm:px-6 mt-16 text-center">
  <div class="max-w-6xl mx-auto flex flex-col items-center justify-center gap-4">

    <div>
      <p class="font-bold text-slate-900 text-sm">KARATEPROFI</p>
      <p class="text-xs text-slate-500 mt-1">Karate mit Herz, Haltung und Tradition in Wien-Favoriten.</p>
    </div>

    <div>
      <a href="/impressum" class="text-sm font-medium text-slate-600 hover:text-sky-600 transition-colors">
        Impressum
      </a>
    </div>

  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-6 mt-6 text-center text-xs text-slate-400">
    &copy; {currentYear} Karateprofi. Alle Rechte vorbehalten.
  </div>
</footer>