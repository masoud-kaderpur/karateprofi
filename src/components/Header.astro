---
// src/components/Header.astro
---
<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md shadow-xs">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between">

    <!-- LOGO -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-sky-500 to-sky-700 flex items-center justify-center text-white font-bold shadow-md shadow-sky-500/20 group-hover:scale-105 transition-transform">
        KP
      </div>
      <div class="flex flex-col">
        <span class="font-extrabold text-slate-900 text-base sm:text-lg tracking-tight leading-none group-hover:text-sky-600 transition-colors">
          KARATEPROFI
        </span>
        <span class="text-[10px] sm:text-xs text-slate-500 font-medium mt-1">
          ASC Universität Wien
        </span>
      </div>
    </a>

    <!-- NAVIGATION LINKS -->
    <nav class="hidden md:flex items-center gap-6">
      <a href="/" class="text-sm font-medium text-slate-600 hover:text-sky-600 transition-colors">Startseite</a>
      <a href="/kurse" class="text-sm font-medium text-slate-600 hover:text-sky-600 transition-colors">Kurse & Zeiten</a>
      <a href="/ueber-uns" class="text-sm font-medium text-slate-600 hover:text-sky-600 transition-colors">Über uns</a>
    </nav>

    <!-- CTA -->
    <div>
      <a href="/#probetraining" class="bg-sky-600 hover:bg-sky-700 text-white text-xs sm:text-sm font-semibold px-4 sm:px-5 py-2.5 rounded-xl transition-all shadow-md shadow-sky-600/20 active:scale-95">
        Probetraining
      </a>
    </div>

  </div>
</header>