<div class="bg-sky-50/60 border border-sky-100 rounded-3xl p-8 sm:p-10 flex flex-col md:flex-row gap-8 items-center">
  <div class="w-full md:w-1/3 flex flex-col items-center text-center">
    <!-- Platzhalter für ein echtes Trainer-Foto -->
    <div class="w-28 h-28 rounded-full bg-sky-200 flex items-center justify-center text-sky-800 font-bold text-2xl mb-4 shadow-inner">
      Dr. C. S.
    </div>
    <h3 class="font-bold text-lg text-slate-900">Dr. Christian Schättle</h3>
    <p class="text-xs text-sky-700 font-semibold mt-1">Staatlich geprüfter Trainer & Pädagoge</p>
  </div>

  <div class="w-full md:w-2/3 border-t md:border-t-0 md:border-l border-sky-200/60 pt-6 md:pt-0 md:pl-8">
    <h4 class="font-bold text-slate-900 text-base mb-2">Kompetenz, die Eltern beruhigt</h4>
    <p class="text-slate-600 text-sm leading-relaxed mb-4">
      Als akademischer Hort- und Freizeitpädagoge sowie erfahrener Kampfsportler (4. Dan Shotokan) weiß Christian genau, wie man Kinder altersgerecht fördert – ohne Leistungsdruck, dafür mit ganz viel Spaß, klaren Werten und Respekt.
    </p>
    <div class="flex flex-wrap gap-2">
      <span class="bg-white text-slate-700 border border-slate-200 text-xs font-medium px-3 py-1 rounded-full">4. Dan Shotokan</span>
      <span class="bg-white text-slate-700 border border-slate-200 text-xs font-medium px-3 py-1 rounded-full">2. Dan Goyu Ryu</span>
      <span class="bg-white text-slate-700 border border-slate-200 text-xs font-medium px-3 py-1 rounded-full">Staatl. Lehrwart</span>
    </div>
  </div>
</div>